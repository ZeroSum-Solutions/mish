{
  "name": "mish",
  "version": "0.22.1",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "description": "Local-first design product: detects your installed code-agent CLI, runs design skills + design systems, streams artifacts into a sandboxed preview.",
  "license": "Apache-2.0",
  "bin": {
    "od": "./apps/daemon/bin/od.mjs"
  },
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs",
    "bootstrap": "node ./scripts/postinstall.mjs",
    "tools-dev": "pnpm exec tools-dev",
    "tools-pack": "pnpm exec tools-pack",
    "tools-release": "pnpm exec tools-release",
    "tools-serve": "pnpm exec tools-serve",
    "guard": "tsx ./scripts/guard.ts",
    "docs:lint": "node ./scripts/docs-lint.mjs --require \"QUICKSTART.md:Team setup\" --require \"docs/architecture.md:8. Agency fast lane (generative UI)\" --require \"docs/agency-site.md:Fast lane: brief to published page\"",
    "lint:craft": "tsx ./scripts/lint-craft-references.ts",
    "i18n:check": "tsx ./scripts/i18n-check.ts",
    "i18n:coverage": "tsx ./scripts/i18n-coverage-report.ts",
    "sync:community-pets": "node --experimental-strip-types scripts/sync-community-pets.ts",
    "bake:community-pets": "node --experimental-strip-types scripts/bake-community-pets.ts",
    "seed:test-projects": "node --experimental-strip-types scripts/seed-test-projects.ts",
    "seed:curated-design-skills": "node --experimental-strip-types scripts/seed-curated-design-skills.ts",
    "backfill:failed-runs": "node --experimental-strip-types scripts/backfill-failed-runs-with-artifacts.ts",
    "typecheck": "pnpm -r --workspace-concurrency=4 --if-present run typecheck && tsc -p scripts/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@mish/components": "workspace:*",
    "@mish/daemon": "workspace:*",
    "@mish/tools-dev": "workspace:*",
    "@mish/tools-pack": "workspace:*",
    "@mish/tools-release": "workspace:*",
    "@mish/tools-serve": "workspace:*",
    "@types/node": "20.19.39",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "~24",
    "pnpm": ">=10.33.2 <11"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@^1": "1.19.15",
      "@opentelemetry/core@^2": "2.8.0",
      "@xmldom/xmldom@^0.8": "0.8.15",
      "@xmldom/xmldom@^0.9": "0.9.12",
      "adm-zip": "0.6.1",
      "baseline-browser-mapping": "2.11.0",
      "body-parser@^2": "2.3.0",
      "brace-expansion": "5.0.12",
      "devalue": "5.8.1",
      "esbuild@^0.27": "0.28.1",
      "esbuild@^0.28": "0.28.1",
      "fast-uri": "3.1.8",
      "fflate@^0.4": "0.4.9",
      "form-data@^4": "4.0.6",
      "hono": "4.13.7",
      "image-size@^2": "2.0.3",
      "ip-address": "10.7.1",
      "js-yaml@^4": "4.3.2",
      "katex": "0.18.2",
      "lodash-es": "4.18.0",
      "mermaid": "11.16.1",
      "nanoid@^3": "3.3.18",
      "nanoid@^5": "5.1.16",
      "postcss": "8.5.23",
      "protobufjs": "8.6.6",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "tar": "7.5.22",
      "tmp": "0.2.7",
      "undici@^6": "6.28.1",
      "undici@^7": "7.29.1",
      "vite@^7": "7.3.5",
      "yaml": "2.9.0"
    },
    "onlyBuiltDependencies": [
      "@ffmpeg-installer/darwin-arm64",
      "@ffmpeg-installer/darwin-x64",
      "@ffmpeg-installer/linux-arm",
      "@ffmpeg-installer/linux-arm64",
      "@ffmpeg-installer/linux-ia32",
      "@ffmpeg-installer/linux-x64",
      "@ffprobe-installer/darwin-arm64",
      "@ffprobe-installer/darwin-x64",
      "@ffprobe-installer/linux-arm",
      "@ffprobe-installer/linux-arm64",
      "@ffprobe-installer/linux-ia32",
      "@ffprobe-installer/linux-x64",
      "@higgsfield/cli",
      "better-sqlite3",
      "core-js",
      "electron",
      "electron-winstaller",
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@google/genai",
      "node-pty"
    ]
  }
}
