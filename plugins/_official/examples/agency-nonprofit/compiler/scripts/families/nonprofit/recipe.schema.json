                    "null"
                  ],
                  "x-atom": "phone",
                  "minLength": 1,
                  "maxLength": 40
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "email",
                  "minLength": 1,
                  "maxLength": 80
                }
