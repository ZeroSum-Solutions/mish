                "properties": {
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "x-verify": "quote"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-atom": "person-name",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "nonprofit-accountability"
            },
            "type": {
              "const": "accountability"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fact"
                ],
                "properties": {
                  "fact": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-atom": "plain",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "upcoming events",
            "dropWhen": "The brief names no real, dated event (a clean-up day, a training session, a fundraiser on a stated date).",
            "keepWhen": "The brief names at least one real upcoming event with a date.",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "nonprofit-events"
            },
            "type": {
              "const": "events"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "date",
                  "title",
                  "body"
                ],
                "properties": {
                  "date": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-atom": "date",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "nonprofit-give"
            },
            "type": {
              "const": "give"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "amount",
                  "period",
                  "impact",
                  "cta"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "amount": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-atom": "amount",
                    "minLength": 1,
                    "maxLength": 16
                  },
                  "period": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-atom": "plain",
                    "minLength": 1,
                    "maxLength": 16
                  },
                  "impact": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "cta": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "nonprofit-volunteer"
            },
            "type": {
              "const": "volunteer"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body",
                "cta"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "cta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "nonprofit-footer"
            },
            "type": {
              "const": "footer"
