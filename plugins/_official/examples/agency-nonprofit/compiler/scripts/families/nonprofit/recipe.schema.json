            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tagline",
                "links",
                "address",
                "phone",
                "email"
              ],
              "properties": {
                "tagline": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "links": {
                  "type": "array",
