{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeroSum-Solutions/mish/schemas/agency-site/nonprofit/recipe.v2.json",
  "title": "nonprofit recipe",
  "description": "A static nonprofit or charity page kind (atlas MI.01): header, stakes hero, mission, programs, optional impact figures, optional stories, accountability facts, optional events, giving levels, volunteering and footer. Derived from compiler/scripts/families/nonprofit/slots.ts by contract.ts recipeSchema(); render.test.ts checks the two are equal.",
  "$comment": "contract.ts additionally enforces markup-free plain text, email and phone formats on the nullable footer contact atoms, and that a null appears only on an x-atom string leaf or in an x-optional section slot (impact, stories, events).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "revision",
    "brand",
    "sections"
  ],
  "sectionOrder": [
    "nonprofit-header",
    "nonprofit-hero",
    "nonprofit-mission",
    "nonprofit-programs",
    "nonprofit-impact",
    "nonprofit-stories",
    "nonprofit-accountability",
    "nonprofit-events",
    "nonprofit-give",
    "nonprofit-volunteer",
    "nonprofit-footer"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "family": {
      "const": "nonprofit"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "descriptor"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "descriptor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": false,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "nonprofit-header"
            },
            "type": {
              "const": "header"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "donateCta"
              ],
              "properties": {
                "donateCta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "nonprofit-hero"
            },
            "type": {
              "const": "hero"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "eyebrow",
                "heading",
                "body",
                "donateCta",
                "volunteerCta"
              ],
              "properties": {
                "eyebrow": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 72
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "donateCta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "volunteerCta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "nonprofit-mission"
            },
            "type": {
              "const": "mission"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "nonprofit-programs"
            },
            "type": {
              "const": "programs"
            },
