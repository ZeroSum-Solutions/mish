                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "body"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "impact figures",
            "dropWhen": "The brief states no measured outcomes (people helped, sites restored, money raised).",
            "keepWhen": "The brief states real, measured outcomes with numbers the organisation can stand behind.",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "nonprofit-impact"
            },
            "type": {
              "const": "impact"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "value"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "x-label": true
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16
                  }
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "named stories",
            "dropWhen": "The brief gives no quote attributable to a named person the work reached.",
            "keepWhen": "The brief quotes real, named volunteers, beneficiaries or supporters.",
            "navSlots": []
