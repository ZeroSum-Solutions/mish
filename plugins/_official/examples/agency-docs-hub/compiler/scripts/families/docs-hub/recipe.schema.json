{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeroSum-Solutions/mish/schemas/agency-site/docs-hub/recipe.v2.json",
  "title": "docs-hub recipe",
  "description": "A static developer documentation hub or knowledge base page kind (atlas CS.02): header with a labelled search field, hero, quick-start steps, a guides grid, optional API/reference entry points, one static code sample, an optional changelog, optional community/support links and a footer. Derived from compiler/scripts/families/docs-hub/slots.ts by contract.ts recipeSchema(); render.test.ts checks the two are equal.",
  "$comment": "contract.ts additionally enforces markup-free plain text, an email format on the nullable email atoms, and that a null appears only on an x-atom string leaf or in an x-optional section’s own slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "revision",
    "brand",
    "sections"
  ],
  "sectionOrder": [
    "docs-hub-header",
    "docs-hub-hero",
    "docs-hub-quickstart",
    "docs-hub-guides",
    "docs-hub-api",
    "docs-hub-code-sample",
    "docs-hub-changelog",
    "docs-hub-community",
    "docs-hub-footer"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "family": {
      "const": "docs-hub"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "descriptor"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "descriptor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": false,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "docs-hub-header"
            },
            "type": {
              "const": "header"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "searchLabel",
                "searchPlaceholder",
                "cta"
              ],
              "properties": {
                "searchLabel": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "searchPlaceholder": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "cta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "docs-hub-hero"
            },
            "type": {
              "const": "hero"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body",
                "cta"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 90
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 280
                },
                "cta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "docs-hub-quickstart"
            },
            "type": {
              "const": "quickstart"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "description"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "docs-hub-guides"
            },
            "type": {
              "const": "guides"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "x-drop": "items",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "description"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "API or reference entry points",
            "dropWhen": "The brief names no API, SDK or reference surface to link into.",
            "keepWhen": "The brief names a real API, SDK or reference surface (a resource or endpoint name and what it does).",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "docs-hub-api"
            },
            "type": {
              "const": "api-reference"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "x-drop": "items",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "description"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "docs-hub-code-sample"
            },
            "type": {
              "const": "code-sample"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "caption"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "caption": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "changelog or what’s new",
            "dropWhen": "The brief gives no release history or \"what’s new\" entries to show.",
            "keepWhen": "The brief names real releases, versions or recent changes to list.",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "docs-hub-changelog"
            },
            "type": {
              "const": "changelog"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "date",
                  "title",
                  "summary"
                ],
                "properties": {
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-atom": "plain",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "date": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-atom": "plain",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 90
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "community and support links",
            "dropWhen": "The brief names no community, support channel or status page.",
            "keepWhen": "The brief names a real community, support channel or status page to point at.",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "docs-hub-community"
            },
            "type": {
              "const": "community-support"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body",
                "supportEmail",
                "communityLink",
                "statusLink"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "supportEmail": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "email",
                  "minLength": 1,
                  "maxLength": 80
                },
                "communityLink": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "plain",
                  "minLength": 1,
                  "maxLength": 60
                },
                "statusLink": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "plain",
                  "minLength": 1,
                  "maxLength": 60
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "docs-hub-footer"
            },
            "type": {
              "const": "footer"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tagline",
                "link1",
                "link2",
                "link3",
                "contactEmail"
              ],
              "properties": {
                "tagline": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "link1": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "plain",
                  "minLength": 1,
                  "maxLength": 32
                },
                "link2": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "plain",
                  "minLength": 1,
                  "maxLength": 32
                },
                "link3": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "plain",
                  "minLength": 1,
                  "maxLength": 32
                },
                "contactEmail": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "email",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          }
        }
      ]
    }
  }
}
