{
  "catalogComponents": [
    "glass-surface",
    "shiny-text",
    "split-text",
    "masked-heading",
    "scroll-reveal",
    "glare-hover"
  ],
  "effects": {
    "scriptPolicy": "hash",
    "maxEffects": 2,
    "placements": {
      "hero-title": {
        "host": {
          "odId": "marketing-site-hero--heading"
        },
        "allow": [
          "split-text",
          "masked-heading"
        ]
      },
      "section-title": {
        "host": {
          "odId": "marketing-site-features--heading"
        },
        "allow": [
          "split-text",
          "masked-heading"
        ]
      },
      "section-reveal": {
        "host": {
          "odId": "marketing-site-features--body"
        },
        "allow": [
          "scroll-reveal"
        ]
      },
      "cta": {
        "host": {
          "id": "marketing-site-cta"
        },
        "allow": [
          "glare-hover"
        ]
      }
    }
  }
}
