  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "revision",
    "brand",
    "sections"
  ],
  "sectionOrder": [
    "listings-header",
    "listings-search",
    "listings-categories",
    "listings-filters",
    "listings-results",
    "listings-compare",
    "listings-featured",
    "listings-reviews",
    "listings-inquiry",
    "listings-footer"
  ],
