{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-design.ai/schemas/agency-site/restaurant/recipe.v2.json",
  "title": "restaurant recipe",
  "description": "A restaurant or food-business page kind (atlas BA.02): header, hero, menu highlights, hours and location, reservations, chef or story, a gallery placeholder, optional reviews and a footer. Derived from compiler/scripts/families/restaurant/slots.ts by contract.ts recipeSchema(); render.test.ts checks the two are equal.",
  "$comment": "contract.ts additionally enforces markup-free plain text, email and phone formats on the nullable atoms, and that a null appears only on an x-atom string leaf or in the x-optional reviews slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "revision",
    "brand",
    "sections"
  ],
  "sectionOrder": [
    "restaurant-header",
    "restaurant-hero",
    "restaurant-menu",
    "restaurant-hours-location",
    "restaurant-reservations",
    "restaurant-story",
    "restaurant-gallery",
    "restaurant-reviews",
    "restaurant-footer"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "family": {
      "const": "restaurant"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "descriptor"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "descriptor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": false,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "restaurant-header"
            },
            "type": {
              "const": "header"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cta"
              ],
              "properties": {
                "cta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "restaurant-hero"
            },
            "type": {
              "const": "hero"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "eyebrow",
                "heading",
                "body",
                "reservationCta"
              ],
              "properties": {
                "eyebrow": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 72
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "reservationCta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "restaurant-menu"
            },
            "type": {
              "const": "menu"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "intro"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "intro": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "description",
                  "price"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140
                  },
                  "price": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-atom": "plain",
                    "minLength": 1,
                    "maxLength": 24
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "restaurant-hours-location"
            },
            "type": {
              "const": "hours-location"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "address",
                "phone"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "x-label": true
                },
                "address": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "address",
                  "minLength": 1,
                  "maxLength": 120
                },
                "phone": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "phone",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "value"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24,
                    "x-verify": "hours-label",
                    "x-hours-value": "value",
                    "x-hours-group": "table"
                  },
                  "value": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-atom": "plain",
                    "minLength": 1,
                    "maxLength": 48
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "restaurant-reservations"
            },
            "type": {
              "const": "reservations"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body",
                "cta"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "cta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "restaurant-story"
            },
            "type": {
              "const": "story"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 280
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "restaurant-gallery"
            },
            "type": {
              "const": "gallery"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "caption",
                  "blurb"
                ],
                "properties": {
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "blurb": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "customer reviews",
            "dropWhen": "The brief carries no diner reviews, names or quotes to show.",
            "keepWhen": "The brief supplies real reviews from diners or guests (a quote and a name).",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "restaurant-reviews"
            },
            "type": {
              "const": "reviews"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "quote",
                  "name"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "x-verify": "quote"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-atom": "person-name",
                    "minLength": 1,
                    "maxLength": 60
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "restaurant-footer"
            },
            "type": {
              "const": "footer"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tagline",
                "links",
                "phone",
                "email",
                "address"
              ],
              "properties": {
                "tagline": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "links": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  }
                },
                "phone": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "phone",
                  "minLength": 1,
                  "maxLength": 40
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "email",
                  "minLength": 1,
                  "maxLength": 80
                },
                "address": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "address",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            }
          }
        }
      ]
    }
  }
}
