{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeroSum-Solutions/mish/schemas/agency-site/practice/recipe.v2.json",
  "title": "practice recipe",
  "description": "A local clinical or appointment practice page kind (atlas TL.01, TL.02): header, hero, services or treatments, provider credentials, what to expect, a book call, optional reviews, insurance or pricing, FAQ, and hours and location, and a footer. Derived from compiler/scripts/families/practice/slots.ts by contract.ts recipeSchema(); render.test.ts checks the two are equal.",
  "$comment": "contract.ts additionally enforces markup-free plain text, email and phone formats on the nullable atoms, and that a null appears only on an x-atom string leaf or in an x-optional section slot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "revision",
    "brand",
    "sections"
  ],
  "sectionOrder": [
    "practice-header",
    "practice-hero",
    "practice-services",
    "practice-providers",
    "practice-expect",
    "practice-book",
    "practice-reviews",
    "practice-insurance",
    "practice-faq",
    "practice-hours-location",
    "practice-footer"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "family": {
      "const": "practice"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "descriptor"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "descriptor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": false,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "practice-header"
            },
            "type": {
              "const": "header"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bookCta"
              ],
              "properties": {
                "bookCta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "practice-hero"
            },
            "type": {
              "const": "hero"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "eyebrow",
                "heading",
                "body",
                "bookCta"
              ],
              "properties": {
                "eyebrow": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48
                },
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 72
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "bookCta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "practice-services"
            },
            "type": {
              "const": "services"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "body"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "x-verify": "traceable"
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "named dentists, doctors or clinicians",
            "dropWhen": "The brief names no dentist, doctor, hygienist or other clinician by name.",
            "keepWhen": "The brief names at least one real clinician of this practice.",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "practice-providers"
            },
            "type": {
              "const": "providers"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "credential"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "x-atom": "person-name"
                  },
                  "credential": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "x-verify": "traceable"
                  }
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "what to expect at a visit, step by step",
            "dropWhen": "The brief does not describe what happens at a visit or appointment.",
            "keepWhen": "The brief describes the steps of a visit or appointment.",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "practice-expect"
            },
            "type": {
              "const": "expect"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "step",
                  "title",
                  "body"
                ],
                "properties": {
                  "step": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24,
                    "x-label": true
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "practice-book"
            },
            "type": {
              "const": "book"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body",
                "cta",
                "destination"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "cta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "destination": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "destination",
                  "x-verify": "destination",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "patient or client reviews",
            "dropWhen": "The brief quotes no patient or client word for word. A brief that only asks for reviews or testimonials supplies none.",
            "keepWhen": "The brief itself contains a patient's or client's own words in quotation marks, with who said them, to show as social proof.",
            "requires": "quote",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "practice-reviews"
            },
            "type": {
              "const": "reviews"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "quote",
                  "name"
                ],
                "properties": {
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "x-verify": "quote"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "x-atom": "person-name"
                  }
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "insurance or pricing",
            "dropWhen": "The brief states no accepted insurance, plan or price the practice can stand behind.",
            "keepWhen": "The brief states real insurance accepted, a plan, or a real price for a service.",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "practice-insurance"
            },
            "type": {
              "const": "insurance"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "body"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "detail",
                  "price"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "x-verify": "traceable"
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "x-verify": "traceable"
                  },
                  "price": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "x-atom": "plain",
                    "minLength": 1,
                    "maxLength": 24
                  }
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "frequently asked questions",
            "dropWhen": "The brief supplies no real question a visitor would ask this practice and no answer for it.",
            "keepWhen": "The brief supplies real, answerable questions specific to this practice.",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "practice-faq"
            },
            "type": {
              "const": "faq"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question",
                  "answer"
                ],
                "properties": {
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  }
                }
              }
            }
          }
        },
        {
          "type": [
            "object",
            "null"
          ],
          "x-optional": {
            "label": "hours and location",
            "dropWhen": "The brief states no real opening hours and no real address or phone for this practice.",
            "keepWhen": "The brief states real opening hours, or a real address or phone, for this practice.",
            "navSlots": []
          },
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "items"
          ],
          "properties": {
            "id": {
              "const": "practice-hours-location"
            },
            "type": {
              "const": "hours-location"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "heading",
                "address",
                "phone"
              ],
              "properties": {
                "heading": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "address": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "address",
                  "minLength": 1,
                  "maxLength": 120
                },
                "phone": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "phone",
                  "x-verify": "destination",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 0,
              "maxItems": 3,
              "x-drop": "items",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "value"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24,
                    "x-verify": "hours-label",
                    "x-hours-value": "value",
                    "x-hours-group": "table"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 48,
                    "x-verify": "traceable"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "const": "practice-footer"
            },
            "type": {
              "const": "footer"
            },
            "text": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tagline",
                "address",
                "phone",
                "email"
              ],
              "properties": {
                "tagline": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "address": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "address",
                  "minLength": 1,
                  "maxLength": 120
                },
                "phone": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "phone",
                  "x-verify": "destination",
                  "minLength": 1,
                  "maxLength": 40
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "x-atom": "email",
                  "x-verify": "destination",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          }
        }
      ]
    }
  }
}
