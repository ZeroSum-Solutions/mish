{
  "name": "@mish/tools-release",
  "version": "0.22.1",
  "private": true,
  "type": "module",
  "bin": {
    "tools-release": "./bin/tools-release.mjs"
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && node --experimental-strip-types ../../packages/metatool/src/cli.ts write .",
    "dev": "tsx ./src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@mish/launcher-proto": "workspace:*",
    "@mish/release": "workspace:*",
    "cac": "6.7.14",
    "sharp": "0.35.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "playwright": "1.60.0"
  },
  "engines": {
    "node": "~24"
  }
}
