{
  "name": "@mish/daemon",
  "version": "0.22.1",
  "private": true,
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "od": "./bin/od.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json",
    "./sidecar": {
      "types": "./dist/sidecar/index.d.ts",
      "default": "./dist/sidecar/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "daemon": "pnpm run build && node dist/cli.js --no-open",
    "dev": "pnpm run build && node dist/cli.js --no-open",
    "start": "pnpm run build && node dist/cli.js",
    "pretest": "pnpm --filter '@mish/daemon^...' --workspace-concurrency=4 --if-present run build",
    "test": "vitest run -c vitest.config.ts",
    "typecheck": "pnpm --filter @mish/contracts build && pnpm --filter @mish/registry-protocol build && pnpm --filter @mish/agency-fast-lane build && pnpm --filter @mish/genui-catalog build && pnpm --filter @mish/section-catalog build && tsc -p tsconfig.json --noEmit && node --max-old-space-size=4096 node_modules/typescript/bin/tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@babel/parser": "7.29.3",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@higgsfield/cli": "1.1.26",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@mish/21st-catalog": "workspace:*",
    "@mish/agency-fast-lane": "workspace:*",
    "@mish/agui-adapter": "workspace:*",
    "@mish/contracts": "workspace:*",
    "@mish/cult-ui-catalog": "workspace:*",
    "@mish/diagnostics": "workspace:*",
    "@mish/genui-catalog": "workspace:*",
    "@mish/launcher-proto": "workspace:*",
    "@mish/platform": "workspace:*",
    "@mish/plugin-runtime": "workspace:*",
    "@mish/registry-protocol": "workspace:*",
    "@mish/release": "workspace:*",
    "@mish/section-catalog": "workspace:*",
    "@mish/sidecar": "workspace:*",
    "@mish/sidecar-proto": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "acorn": "8.15.0",
    "acorn-jsx": "5.3.2",
    "better-sqlite3": "12.10.0",
    "blake3-wasm": "2.1.5",
    "cheerio": "1.2.0",
    "chokidar": "3.6.0",
    "express": "5.2.1",
    "gsap": "3.15.0",
    "hyperframes": "0.8.1",
    "jsonc-parser": "3.3.1",
    "jszip": "3.10.1",
    "kiwi-schema": "0.5.0",
    "multer": "2.4.0",
    "node-pty": "1.1.0",
    "pdf-lib": "1.17.1",
    "postcss": "8.5.23",
    "postcss-value-parser": "4.2.0",
    "posthog-node": "5.34.6",
    "pptxgenjs": "4.0.1",
    "prom-client": "15.1.3",
    "tar": "7.5.22",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@babel/types": "7.29.0",
    "@gsap/react": "2.1.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/multer": "2.1.0",
    "@types/node": "20.19.39",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/styled-components": "5.1.36",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "styled-components": "5.3.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "~24"
  }
}
