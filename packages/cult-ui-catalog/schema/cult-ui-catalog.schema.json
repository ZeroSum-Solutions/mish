{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mishhmashh.local/schemas/cult-ui-catalog-1.json",
  "title": "Cult UI Pro catalog",
  "description": "catalog.json of @open-design/cult-ui-catalog: one row per Cult UI Pro registry item, metadata and hashes only. Generated by scripts/import.ts from the private source kit. Validated by src/validate.ts, a dependency-free validator for the subset of JSON Schema used here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": "cult-ui-catalog/1"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableBytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sectionKind": {
      "enum": [
        "navigation",
        "hero",
        "features",
        "services",
        "benefits",
        "process-steps",
        "proof-gallery",
        "product-grid",
        "pricing",
        "plan-comparison",
        "testimonials",
        "reviews-ratings",
        "stats-metrics",
        "logo-wall",
        "team",
        "about-story",
        "manifesto-statement",
        "faq",
        "blog-articles",
        "newsletter-waitlist",
        "contact-form",
        "booking-availability",
        "location-map-hours",
        "cta-band",
        "footer",
        "timeline-roadmap",
        "integrations",
        "specifications",
        "page-composition",
        "unclassified"
      ]
    },
    "componentId": {
      "enum": [
        "sticky-nav",
        "mega-menu",
        "marquee-ticker",
        "carousel-slider",
        "before-after-slider",
        "tabs",
        "accordion",
        "card-grid",
        "bento-grid",
        "masonry",
        "modal-dialog",
        "custom-cursor",
        "video-background",
        "3d-canvas-webgl",
        "particle-shader-field",
        "number-counter",
        "filter-search",
        "form",
        "toggle-switch",
        "scroll-progress",
        "hotspots-tooltips",
        "floating-glass-panel",
        "split-screen",
        "hud-dock"
      ]
    },
    "spineCode": {
      "enum": [
        "TL",
        "PA",
        "CO",
        "SM",
        "CS",
        "LM",
        "BA",
        "TU",
        "MI"
      ]
    },
    "assetKind": {
      "enum": [
        "section",
        "page",
        "primitive",
        "app"
      ]
    },
    "conversionStatus": {
      "enum": [
        "pending-fetch",
        "unconverted",
        "insertable",
        "adapter-needed",
        "app-only"
      ]
    },
    "portQueue": {
      "description": "Reviewed conversion queue of a primitive or app row, set only by reviewed-overrides.json.",
      "enum": [
        "genui-port",
        "css-surface",
        "app-only"
      ]
    },
    "runtimeFeature": {
      "enum": [
        "ai-sdk",
        "api-routes",
        "browser-apis",
        "canvas",
        "env-secrets",
        "external-services",
        "motion",
        "redis",
        "server-actions",
        "shaders",
        "syntax-highlighting",
        "webgl"
      ]
    },
    "interaction": {
      "enum": [
        "click",
        "drag",
        "hover",
        "input",
        "keyboard",
        "scroll",
        "state"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "indexSha256",
        "registryUrlPattern",
        "expectedItems",
        "fetchedItems",
        "pendingItems",
        "derivedRows"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cult-ui-pro@[0-9a-f]{16}$"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "indexSha256": {
          "$ref": "#/$defs/sha256"
        },
        "registryUrlPattern": {
          "const": "https://pro.cult-ui.com/api/registry/<name>"
        },
        "expectedItems": {
          "type": "integer",
          "minimum": 0
        },
        "fetchedItems": {
          "type": "integer",
          "minimum": 0
        },
        "pendingItems": {
          "type": "integer",
          "minimum": 0
        },
        "derivedRows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "target",
        "type",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "bytes": {
          "$ref": "#/$defs/nullableBytes"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "title",
        "description",
        "original",
        "source",
        "rights",
        "assetKind",
        "taxonomy",
        "spineAffinities",
        "dependencies",
        "runtimeFeatures",
        "requirements",
        "conversion",
        "adapter",
        "previewId",
        "measuredBytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cult:[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "original": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "category",
            "tags",
            "useCases",
            "style",
            "features",
            "registryDependencies"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string"
            },
            "tags": {
              "$ref": "#/$defs/strings"
            },
            "useCases": {
              "$ref": "#/$defs/strings"
            },
            "style": {
              "type": [
                "object",
                "null"
              ]
            },
            "features": {
              "$ref": "#/$defs/strings"
            },
            "registryDependencies": {
              "$ref": "#/$defs/strings"
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshotId",
            "registrySha256",
            "files"
          ],
          "properties": {
            "snapshotId": {
              "type": "string",
              "minLength": 1
            },
            "registrySha256": {
              "$ref": "#/$defs/nullableSha256"
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sourceFile"
              }
            }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "license",
            "decision",
            "evidence"
          ],
          "properties": {
            "license": {
              "const": "licensed"
            },
            "decision": {
              "const": "bundle"
            },
            "evidence": {
              "const": "docs/legal/cult-ui-pro-rights.md"
            }
          }
        },
        "assetKind": {
          "$ref": "#/$defs/assetKind"
        },
        "taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sectionKind",
            "components",
            "style"
          ],
          "properties": {
            "sectionKind": {
              "$ref": "#/$defs/sectionKind"
            },
            "components": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/componentId"
              }
            },
            "style": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "density": {
                  "enum": [
                    "airy",
                    "balanced",
                    "dense"
                  ]
                }
              }
            }
          }
        },
        "spineAffinities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spineCode"
          }
        },
        "dependencies": {
          "$ref": "#/$defs/strings"
        },
        "runtimeFeatures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeFeature"
          }
        },
        "requirements": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetHosts",
                "images",
                "interactions"
              ],
              "properties": {
                "assetHosts": {
                  "$ref": "#/$defs/strings"
                },
                "images": {
                  "type": "boolean"
                },
                "interactions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/interaction"
                  }
                }
              }
            }
          ]
        },
        "conversion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/conversionStatus"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "adapter": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version",
                "sourceSha256"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^cult:[a-z0-9][a-z0-9-]*$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "previewId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "measuredBytes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "html",
            "css",
            "js"
          ],
          "properties": {
            "html": {
              "$ref": "#/$defs/nullableBytes"
            },
            "css": {
              "$ref": "#/$defs/nullableBytes"
            },
            "js": {
              "$ref": "#/$defs/nullableBytes"
            }
          }
        },
        "demoOf": {
          "type": "string",
          "pattern": "^cult:[a-z0-9][a-z0-9-]*$"
        },
        "derivedFrom": {
          "description": "Set on a section cut from a whole-page row by the converter: the page row's id. Not a registry item; counted in snapshot.derivedRows.",
          "type": "string",
          "pattern": "^cult:[a-z0-9][a-z0-9-]*$"
        },
        "portQueue": {
          "$ref": "#/$defs/portQueue"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields",
            "note"
          ],
          "properties": {
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
