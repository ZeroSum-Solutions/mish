{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mishhmashh.local/schemas/section-catalog-1.json",
  "title": "Section catalog",
  "description": "catalog.json of @mish/section-catalog: HyperUI blocks, the agency families' own sections, and the Cult UI Pro section/page projection (from packages/cult-ui-catalog/catalog.json), normalized to one rights-labeled entry shape. MotionSites entries are federated at request time (see src/motionsites.ts) and are never baked into this file. Generated by scripts/build-catalog.ts. Validated by src/validate.ts, a dependency-free validator for the subset of JSON Schema used here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": { "const": "section-catalog/1" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "sectionKind": {
      "enum": [
        "navigation", "hero", "features", "services", "benefits", "process-steps", "proof-gallery",
        "product-grid", "pricing", "plan-comparison", "testimonials", "reviews-ratings",
        "stats-metrics", "logo-wall", "team", "about-story", "manifesto-statement", "faq",
        "blog-articles", "newsletter-waitlist", "contact-form", "booking-availability",
        "location-map-hours", "cta-band", "footer", "timeline-roadmap", "integrations",
        "specifications", "page-composition", "unclassified"
      ]
    },
    "spineCode": { "enum": ["TL", "PA", "CO", "SM", "CS", "LM", "BA", "TU", "MI"] },
    "spineAffinities": {
      "description": "Every spine the section fits, 'any' when it fits all of them (a generic hero or CTA), or 'unclassified' when that is unclear. Never defaults to one spine as a guess.",
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/$defs/spineCode" }, "minItems": 1 },
        { "const": "any" },
        { "const": "unclassified" }
      ]
    },
    "sourceKind": { "enum": ["hyperui", "motionsites-prompt", "family-section", "local-corpus", "cult-pro"] },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "decision", "evidence"],
      "properties": {
        "license": { "enum": ["MIT", "proprietary", "project-specific", "licensed"] },
        "decision": { "enum": ["bundle", "metadata-only", "same-family-only"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "access": { "enum": ["local", "free-account", "paid-account"] },
    "availability": { "enum": ["insertable", "reference-only", "adapter-needed"] },
    "preview": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "artifactId"],
          "properties": { "kind": { "const": "local" }, "artifactId": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "url"],
          "properties": { "kind": { "const": "external-link" }, "url": { "type": "string", "pattern": "^https://" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        }
      ]
    },
    "content": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "blockId", "sha256"],
          "properties": {
            "kind": { "const": "vendored-block" },
            "blockId": { "type": "string", "minLength": 1 },
            "adapterId": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "remoteId", "url"],
          "properties": {
            "kind": { "const": "motion-prompt" },
            "remoteId": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "family", "sectionId"],
          "properties": {
            "kind": { "const": "family-section" },
            "family": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "sectionId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "corpusId"],
          "properties": {
            "kind": { "const": "local-prompt" },
            "corpusId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "summary", "sourceTitle", "provenance"],
          "properties": {
            "kind": { "const": "cult-item" },
            "summary": { "type": "string", "minLength": 1 },
            "sourceTitle": { "type": "string", "minLength": 1 },
            "provenance": {
              "type": "object", "additionalProperties": false, "required": ["cultId", "snapshotId"],
              "properties": {
                "cultId": { "type": "string", "pattern": "^cult:[a-z0-9][a-z0-9-]*$" },
                "snapshotId": { "type": "string", "pattern": "^cult-ui-pro@[a-f0-9]{16}$" }
              }
            },
            "adapterId": { "type": "string", "pattern": "^cult:[a-z0-9][a-z0-9-]*$" }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sourceKind", "sectionKind", "spineAffinities", "rights", "access", "availability", "preview", "content"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "sourceKind": { "$ref": "#/$defs/sourceKind" },
        "sectionKind": { "$ref": "#/$defs/sectionKind" },
        "sourceType": { "type": "string", "minLength": 1 },
        "spineAffinities": { "$ref": "#/$defs/spineAffinities" },
        "rights": { "$ref": "#/$defs/rights" },
        "access": { "$ref": "#/$defs/access" },
        "availability": { "$ref": "#/$defs/availability" },
        "preview": { "$ref": "#/$defs/preview" },
        "content": { "$ref": "#/$defs/content" }
      }
    }
  }
}
