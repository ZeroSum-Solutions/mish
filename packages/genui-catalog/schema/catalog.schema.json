{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mishhmashh.local/schemas/genui-catalog-1.json",
  "title": "GenUI component catalog",
  "description": "catalog.json of @mish/genui-catalog. Generated by scripts/build-catalog.ts from data/catalog-seed.json (one row per component in the master CSV) and data/cult-ui-pro-seed.json (licensed Cult UI Pro ports) merged with components/<id>/meta.json (the source of truth for a component the package carries). Validated by src/validate.ts, a dependency-free validator for the subset of JSON Schema used here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "components"],
  "properties": {
    "schema": { "const": "genui-catalog/1" },
    "components": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$" },
    "category": {
      "enum": ["surface", "hover", "text", "scroll", "gallery", "hero", "background", "navigation", "input"]
    },
    "kind": {
      "description": "css-only: works from the class and custom properties alone, with no script (safe under script-src 'none'). js: needs mount().",
      "enum": ["css-only", "js"]
    },
    "status": { "enum": ["planned", "ported"] },
    "entryPath": { "type": "string", "pattern": "^components/[a-z0-9][a-z0-9-]*/index\\.ts$" },
    "cssPath": { "type": "string", "pattern": "^components/[a-z0-9][a-z0-9-]*/styles\\.css$" },
    "demoPath": { "type": "string", "pattern": "^components/[a-z0-9][a-z0-9-]*/demo\\.html$" },
    "props": {
      "description": "JSON Schema (draft 2020-12) of the mount() options, with a default per property.",
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "object" },
        "properties": { "type": "object" }
      }
    },
    "a11y": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reducedMotion": { "enum": ["static", "reduced", "none-needed"] },
    "motion": {
      "description": "Set only where verified from the component's own source: its *default* (non-reduced-motion) render keeps a requestAnimationFrame/CSS-infinite loop running continuously, as opposed to a one-shot entrance transition. Read by apps/daemon/src/workbench/resources.ts to derive a 'continuous-motion' styleTag for apps/daemon/src/workbench/context-ranking.ts's default-suppression gate.",
      "enum": ["continuous"]
    },
    "styleClass": {
      "description": "The entry's visual style is itself retro/skeuomorphic. Read by apps/daemon/src/workbench/resources.ts, mirroring apps/daemon/src/workbench/context-ranking.ts's styleClass: 'retro' convention.",
      "enum": ["retro"]
    },
    "bytes": {
      "description": "Minified size of the built component (JS bundle and CSS), computed by scripts/build-catalog.ts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["js", "css"],
      "properties": {
        "js": { "type": "integer", "minimum": 0 },
        "css": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "component", "license", "category", "description", "dependencies"],
      "properties": {
        "name": { "enum": ["react-bits", "21st.dev", "kokonut-ui", "cult-ui-pro", "original"] },
        "component": { "type": "string", "minLength": 1 },
        "license": {
          "description": "Licence evidence: the master CSV's License column, verbatim (for cult-ui-pro rows, the licence record in docs/legal/cult-ui-pro-rights.md).",
          "type": "string",
          "minLength": 1
        },
        "category": { "description": "The master CSV's Category column, verbatim.", "type": "string" },
        "description": { "description": "The master CSV's 'What it does' column, verbatim.", "type": "string" },
        "dependencies": { "description": "The master CSV's Dependencies column, verbatim.", "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "category", "source", "sourceUrl", "licenceDecision", "verdict", "rationale",
        "tier", "tierNote", "portDifficulty", "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/category" },
        "kind": { "$ref": "#/$defs/kind" },
        "source": { "$ref": "#/$defs/source" },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "licenceDecision": { "enum": ["port-with-attribution", "clean-room", "licensed", "cut"] },
        "verdict": { "enum": ["keep", "maybe", "cut"] },
        "rationale": { "type": "string", "minLength": 1 },
        "tier": { "enum": [1, 2, 3, null] },
        "tierNote": { "description": "The master CSV's 'Broken English tier' column, verbatim (client-specific signal).", "type": "string" },
        "portDifficulty": { "enum": ["Easy", "Medium", "Hard"] },
        "status": { "$ref": "#/$defs/status" },
        "entry": { "$ref": "#/$defs/entryPath" },
        "css": { "$ref": "#/$defs/cssPath" },
        "demo": { "$ref": "#/$defs/demoPath" },
        "bytes": { "$ref": "#/$defs/bytes" },
        "props": { "$ref": "#/$defs/props" },
        "a11y": { "$ref": "#/$defs/a11y" },
        "reducedMotion": { "$ref": "#/$defs/reducedMotion" },
        "motion": { "$ref": "#/$defs/motion" },
        "styleClass": { "$ref": "#/$defs/styleClass" }
      },
      "if": { "properties": { "status": { "const": "ported" } } },
      "then": { "required": ["kind", "entry", "css", "demo", "bytes", "props", "a11y", "reducedMotion"] }
    },
    "componentMeta": {
      "description": "components/<id>/meta.json. It overrides the seed row for every field it sets; licence evidence, verdict and rationale come from the seed unless meta.json sets them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/category" },
        "kind": { "$ref": "#/$defs/kind" },
        "status": { "$ref": "#/$defs/status" },
        "licenceDecision": { "enum": ["port-with-attribution", "clean-room", "licensed", "cut"] },
        "verdict": { "enum": ["keep", "maybe", "cut"] },
        "rationale": { "type": "string", "minLength": 1 },
        "entry": { "$ref": "#/$defs/entryPath" },
        "css": { "$ref": "#/$defs/cssPath" },
        "demo": { "$ref": "#/$defs/demoPath" },
        "props": { "$ref": "#/$defs/props" },
        "a11y": { "$ref": "#/$defs/a11y" },
        "reducedMotion": { "$ref": "#/$defs/reducedMotion" },
        "motion": { "$ref": "#/$defs/motion" },
        "styleClass": { "$ref": "#/$defs/styleClass" }
      },
      "if": { "properties": { "status": { "const": "ported" } } },
      "then": { "required": ["kind", "entry", "css", "demo", "props", "a11y", "reducedMotion"] }
    }
  }
}
