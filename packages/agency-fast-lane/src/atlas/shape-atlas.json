  "transferNotes": {
    "TL": {
      "headline": "Trust to lead transfers best to booking and mission-led sites.",
      "transfer": "Keep service, proof, process, and contact blocks. Replace vertical evidence and the final action."
    },
    "PA": {
      "headline": "Product adoption transfers well to commerce, content, and task utilities.",
      "transfer": "Keep problem, demonstration, proof, and offer logic. Replace onboarding depth, transaction rules, and product evidence."
    },
    "CO": {
      "headline": "Commerce transfers best to marketplaces, booking, and product adoption.",
      "transfer": "Keep discovery, evaluation, reassurance, and selection. Replace inventory ownership, checkout, fulfillment, and account rules."
    },
    "SM": {
      "headline": "Search and match transfers well to commerce, booking, and task utilities.",
      "transfer": "Keep query, filter, comparison, and detail views. Replace the entity model, ranking logic, trust signals, and transaction endpoint."
    },
    "CS": {
      "headline": "Content subscription transfers well to learning, product education, and mission sites.",
      "transfer": "Keep discovery, hierarchy, related content, and return loops. Replace editorial authority, taxonomy, and subscription promise."
    },
    "LM": {
      "headline": "Learning membership transfers broadly to content, booking, utility, and mission systems.",
      "transfer": "Keep transformation, proof, commitment, and participation. Replace curriculum, member state, access rules, and completion signals."
    },
    "BA": {
      "headline": "Booking attendance transfers directly to service lead generation and strongly to marketplaces.",
      "transfer": "Keep availability, option comparison, reassurance, and reservation. Replace inventory, scheduling constraints, and cancellation policy."
    },
    "TU": {
      "headline": "Task utility transfers well to product adoption, directories, learning, and public service.",
      "transfer": "Keep orientation, inputs, feedback, and history. Replace permissions, records, actions, and state transitions."
    },
    "MI": {
      "headline": "Mission impact transfers best to trust-led, content, learning, and public-service sites.",
      "transfer": "Keep stakes, credibility, evidence, and participation. Replace beneficiary model, impact claims, contribution rules, and reporting."
    }
  },
